# oneforall_tree_double_xcheck.sub
#
# Phase-1 per-period feeders for a listed set of variant configs (appendix
# cross-checks, single-variant re-runs). Same job as oneforall_tree_double.sub,
# but it queues only the configs named in the list given on the command line:
#   condor_submit list_file=xcheck_feeders_20260910.list oneforall_tree_double_xcheck.sub
#
# Memory: 16GB (17 parallel ROOT processes per pass, ~8-12 GB peak).

universe              = vanilla
request_memory        = 16GB

PeriodicHold          = (NumJobStarts>=1 && JobStatus == 1)
Notification          = Never

executable            = /bin/bash
arguments             = "oneforall_tree_double_dispatch.sh $(cfg)"

log                   = /tmp/ppg12_xcheck_feeders_$(Cluster).log
output                = logs/$(cfg).tree_double.out
error                 = logs/$(cfg).tree_double.err

queue cfg from $(list_file)
