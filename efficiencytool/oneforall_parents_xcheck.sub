# oneforall_parents_xcheck.sub
#
# Phase-2 all-range parents for a listed set of variant configs. Parents only,
# with no _0rad/_1p5mrad feeders in the batch, so each parent reads static
# feeders and the parent-vs-feeder merge race cannot occur. Pass the list on
# the command line:
#   condor_submit list_file=xcheck_parents_20260910.list oneforall_parents_xcheck.sub

universe              = vanilla

PeriodicHold                  = (NumJobStarts>=1 && JobStatus == 1)
Notification                  = Never

executable            = /bin/bash
arguments             = "oneforall.sh $(cfg)"

request_memory        = 2GB
log                   = /tmp/ppg12_xcheck_parents_$(Cluster).log
output                = logs/$(cfg).out
error                 = logs/$(cfg).err

queue cfg from $(list_file)
